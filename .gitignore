.venv/
__pycache__/
*.pyc
*.egg-info/
.DS_Store
*.log

# Data — never committed (regeneratable from synth)
data/raw/
data/interim/
#data/processed/

# Runs — large; pull selectively if needed
runs/*/checkpoints/
runs/*/loss.jsonl

# Merged / quantized model artifacts (regeneratable from HF Hub adapter)
models/

# Eval reports (large JSONL + summary JSON; regeneratable from judge runs)
eval/reports/

# RunPod pod-id state file (written by scripts/pod_up, read by scripts/pod_down)
.runpod_pod_id

# Local secrets
.env
